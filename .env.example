# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lovable_ai
DB_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Model API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Default AI Model Configuration
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4-turbo-preview

# AWS S3 (Optional - for artifact storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=lovable-ai-artifacts

# Application Settings
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Generation Settings
MAX_GENERATION_TIME=300
MAX_INTERVIEW_QUESTIONS=25
MIN_INTERVIEW_QUESTIONS=10
